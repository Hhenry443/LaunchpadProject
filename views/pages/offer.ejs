<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Offer</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body class="bg-[#F2E8CF] min-h-screen font-sans">
    <%- include('../partials/header') %>

    <div class="flex justify-center pt-12 pb-8 px-4">
      <div class="bg-white p-10 rounded-2xl w-full max-w-xl">

        <button
          class="bg-[#A7C957] text-[#335D3B] px-4 py-2 rounded-lg mb-5 font-bold hover:bg-[#6A994E] hover:text-white transition-colors cursor-pointer"
          onclick="history.back()">
          &larr; Back
        </button>

        <h1 class="text-2xl font-bold text-[#335D3B] mb-6">Create Offer</h1>

        <form id="postForm">

          <label class="block mb-1 font-bold text-[#335D3B]" for="name">Your Name*</label>
          <input class="w-full px-4 py-3 mb-4 rounded-lg border-2 border-[#A7C957] bg-[#F2E8CF] text-[#335D3B] outline-none focus:border-[#6A994E]" type="text" id="name" placeholder="Enter your name" required>

          <label class="block mb-1 font-bold text-[#335D3B]" for="allotment">Allotment Location*</label>
          <input class="w-full px-4 py-3 mb-4 rounded-lg border-2 border-[#A7C957] bg-[#F2E8CF] text-[#335D3B] outline-none focus:border-[#6A994E]" type="text" id="allotment" placeholder="e.g. North Western Terrace Allotments" required>

          <label class="block mb-1 font-bold text-[#335D3B]" for="plot">Plot Number</label>
          <input class="w-full px-4 py-3 mb-4 rounded-lg border-2 border-[#A7C957] bg-[#F2E8CF] text-[#335D3B] outline-none focus:border-[#6A994E]" type="text" id="plot" placeholder="e.g. Plot 12">

          <label class="block mb-1 font-bold text-[#335D3B]" for="produce">Produce Type*</label>
          <input class="w-full px-4 py-3 mb-4 rounded-lg border-2 border-[#A7C957] bg-[#F2E8CF] text-[#335D3B] outline-none focus:border-[#6A994E]" type="text" id="produce" placeholder="e.g. Tomatoes" required>

          <label class="block mb-1 font-bold text-[#335D3B]" for="amount">Amount Available*</label>
          <input class="w-full px-4 py-3 mb-4 rounded-lg border-2 border-[#A7C957] bg-[#F2E8CF] text-[#335D3B] outline-none focus:border-[#6A994E]" type="text" id="amount" placeholder="e.g. 2 bags" required>

          <label class="block mb-1 font-bold text-[#335D3B]" for="time">Collection Time (Days of the week and times you would be available for collection)</label>
          <input class="w-full px-4 py-3 mb-4 rounded-lg border-2 border-[#A7C957] bg-[#F2E8CF] text-[#335D3B] outline-none focus:border-[#6A994E]" type="text" id="time" placeholder="e.g. Mon-Fri 9am-3pm">

          <button class="w-full py-3 rounded-lg bg-[#386641] text-[#F2E8CF] text-base cursor-pointer hover:bg-[#335D3B] transition-colors" type="submit">
            Post Offer
          </button>
          <p class="block mt-3 text-[#BC4749] text-xs">* Required fields</p>

        </form>
      </div>
    </div>

    <script src="./js/allotments.js"></script>
  </body>
</html>
