<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head'); %>
    <style>
      .marker-icon-foodbank {
        color: #335d3b; /* icon colour */
        font-size: 2rem; /* icon size */
        cursor: pointer;
        filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.4));
      }

      .marker-icon-allotment {
        color: #6a994e; /* icon colour */
        font-size: 2rem; /* icon size */
        cursor: pointer;
        filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.4));
      }

      .mapboxgl-popup {
        max-width: 200px;
        padding: 5px;
      }

      .mapboxgl-popup-content {
        text-align: center;
        font-family: "Open Sans", sans-serif;
      }
    </style>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>

  <body class="bg-[#F2E8CF]">
    <header><%- include('../partials/header'); %></header>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <main class="py-6">
        <div
          id="map"
          class="h-[600px] w-full max-w-full rounded-lg shadow"
        ></div>
      </main>

      <script>
        // @ts-ignore
        const foodBankMarkers = <%- JSON.stringify(foodbankMarkers) %>;

        const allotmentMarkers = <%- JSON.stringify(allotmentMarkers) %>;

        const MAPBOX_TOKEN = "<%= mapboxToken %>";
      </script>

      <div
        id="Key"
        class="w-auto bg-[#6A994E] rounded-lg flex items-center flex-col space-y-2 p-4 mb-6 text-white"
      >
        <p class="font-bold w-full text-center">Purchasing Power of Area</p>
        <div
          class="w-80/100 h-5 bg-gradient-to-r from-[rgb(215,25,28)] via-[rgb(255,255,102)] to-[rgb(44,123,182)] rounded-lg"
        ></div>
        <div class="w-8/10 flex justify-between font-semibold">
          <p>Greater</p>
          <p>Lesser</p>
        </div>
      </div>

      <div
        id="toggleButtons"
        class="w-auto bg-[#6A994E] rounded-lg flex items-center flex-col gap-4 p-4"
      >
        <p class="font-bold w-full text-center text-white">Map Toggles</p>
        <div
          id="buttons"
          class="w-full flex flex-col sm:flex-row items-center justify-around text-center gap-4"
        ></div>
      </div>

      <script src="/js/markers.js"></script>

      <script src="/js/purchasingPower.js"></script>

      <script src="/js/toggleButtons.js"></script>
    </div>

    <footer><%- include('../partials/footer'); %></footer>
  </body>
</html>
